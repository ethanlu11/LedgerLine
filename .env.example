# Postgres connection string.
#
# Local: `npm run db:start` boots a Postgres on port 55432 and prints this exact
# value. Copy this file to .env and you are done.
DATABASE_URL="postgresql://ledgerline:ledgerline@localhost:55432/ledgerline?schema=public"

# On Vercel, set DATABASE_URL in Project Settings → Environment Variables.
# Use your provider's POOLED connection string — serverless functions open a
# connection per invocation and a direct one will exhaust the server's limit.
# Neon, Supabase and Vercel Postgres all expose a pooled host.
