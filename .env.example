# Postgres connection strings.
#
# Local: `npm run db:start` boots a Postgres on port 55432 and prints these.
# There is no pooler locally, so both point at the same database.
DATABASE_URL="postgresql://ledgerline:ledgerline@localhost:55432/ledgerline?schema=public"
DATABASE_URL_UNPOOLED="postgresql://ledgerline:ledgerline@localhost:55432/ledgerline?schema=public"

# On Vercel both are provided by the Neon integration:
#   DATABASE_URL          — pooled, used to serve pages
#   DATABASE_URL_UNPOOLED — direct, used only to run migrations
